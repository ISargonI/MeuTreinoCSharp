<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PostoOasis.App.ViewModels"
             xmlns:m="using:PostoOasis.Core.Models"
             x:Class="PostoOasis.App.Views.CaixaView"
             x:DataType="vm:MainWindowViewModel"
             Background="{DynamicResource AppBackground}">

    <ScrollViewer Padding="20">
        <StackPanel Spacing="16">
            
            <!-- Cabeçalho com Badges dos Casos de Uso do Caixa -->
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Frente de Caixa &amp; PDV Integrado" Classes="headerTitle"/>
                    <TextBlock Text="Faturamento unificado de pista e conveniência, simulação de maquininha de cartão e NF-e." Classes="subTitle"/>
                </StackPanel>
                
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Border Classes="badge"><TextBlock Text="UC2 / RF02: PDV Integrado"/></Border>
                    <Border Classes="badge"><TextBlock Text="RN01: Formas de Pagamento"/></Border>
                    <Border Classes="badge"><TextBlock Text="RN03: Vale-Lavagem R$ 200"/></Border>
                    <Border Classes="badge"><TextBlock Text="RF03: Nota Fiscal (NF-e)"/></Border>
                    <Border Classes="badge"><TextBlock Text="RN17: Cancelamento 30 Min"/></Border>
                </WrapPanel>
            </Grid>

            <!-- Feedback / Mensagem de Alerta do Caixa -->
            <Border Background="{DynamicResource AppItemBg}" BorderBrush="{DynamicResource AppAccent}" BorderThickness="1" CornerRadius="6" Padding="12,8"
                    IsVisible="{Binding MensagemCaixa, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Grid ColumnDefinitions="Auto, *">
                    <TextBlock Grid.Column="0" Text="🔔 " FontSize="14"/>
                    <TextBlock Grid.Column="1" Text="{Binding MensagemCaixa}" Foreground="{DynamicResource AppAccent}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <!-- Ponto Eletrônico do Operador de Caixa -->
            <Border Classes="card">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Ponto Eletrônico do Operador de Caixa [RF17]" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AppTextPrimary}"/>
                        <TextBlock Text="Registre entrada, intervalos e encerramento de turno de trabalho:" FontSize="10" Foreground="{DynamicResource AppTextSecondary}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Content="Entrada" Command="{Binding BaterPontoCaixaCommand}" CommandParameter="Entrada" Background="{DynamicResource AppBtnSuccessBg}" Foreground="White" FontSize="10" Padding="8,4"/>
                        <Button Content="Almoço" Command="{Binding BaterPontoCaixaCommand}" CommandParameter="SaidaIntervalo" Background="{DynamicResource AppBtnNeutralBg}" Foreground="White" FontSize="10" Padding="8,4"/>
                        <Button Content="Retorno" Command="{Binding BaterPontoCaixaCommand}" CommandParameter="RetornoIntervalo" Background="{DynamicResource AppBtnNeutralBg}" Foreground="White" FontSize="10" Padding="8,4"/>
                        <Button Content="Saída" Command="{Binding BaterPontoCaixaCommand}" CommandParameter="Saida" Background="{DynamicResource AppBtnDangerBg}" Foreground="White" FontSize="10" Padding="8,4"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Estrutura Principal do PDV: Duas Colunas -->
            <Grid ColumnDefinitions="*, 430">
                
                <!-- Coluna Esquerda: Abastecimentos Pendentes e Catálogo de Conveniência -->
                <StackPanel Grid.Column="0" Spacing="14">
                    
                    <!-- 1. Abastecimentos Pendentes da Pista (RF01 -> RF02 Integração) -->
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Abastecimentos Pendentes da Pista [RF01 ➔ RF02]" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AppTextPrimary}"/>
                            <TextBlock Text="Selecione um abastecimento da pista para puxar para o cupom fiscal:" FontSize="10" Foreground="{DynamicResource AppTextSecondary}"/>
                            
                            <ItemsControl ItemsSource="{Binding BombasPendentesCaixa}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:Bomba">
                                        <Border Background="{DynamicResource AppItemBg}" BorderBrush="{DynamicResource AppCardBorder}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,3">
                                            <Grid ColumnDefinitions="120, *, 100, Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding Identificador}" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="{Binding LitrosAbastecidos, StringFormat='{}{0:F2} Litros'}" Foreground="{DynamicResource AppTextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ValorTotalCalculado, StringFormat='R$ {0:F2}'}" FontWeight="Bold" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center" FontSize="11"/>
                                                <Button Grid.Column="3" Content="Incluir no Cupom" 
                                                        Command="{Binding $parent[UserControl].DataContext.SelecionarBombaPendenteCaixaCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="{DynamicResource AppBtnPrimaryBg}" Foreground="White" FontSize="10" Padding="8,4"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Exibe se tem abastecimento selecionado -->
                            <Border Background="{DynamicResource AppItemBg}" BorderBrush="{DynamicResource AppAccent}" BorderThickness="1" CornerRadius="6" Padding="8" IsVisible="{Binding BombaPendenteSelecionada, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Text="{Binding BombaPendenteSelecionada.ValorTotalCalculado, StringFormat='Abastecimento ativo no cupom: R$ {0:F2}'}" 
                                           Foreground="{DynamicResource AppAccent}" FontWeight="Bold" FontSize="11"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 2. Catálogo de Produtos da Loja de Conveniência (RF02 / RF11) -->
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Itens da Loja de Conveniência [RF02 / RF11]" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AppTextPrimary}"/>
                            <TextBlock Text="Clique para adicionar produtos ao carrinho de compras:" FontSize="10" Foreground="{DynamicResource AppTextSecondary}"/>
                            
                            <ItemsControl ItemsSource="{Binding ProdutosCaixa}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:Produto">
                                        <Border Classes="card" Width="180" Margin="0,0,8,8" Padding="10">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding Nome}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AppTextPrimary}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Preco, StringFormat='R$ {0:F2}'}" FontWeight="Bold" Foreground="{DynamicResource AppAccent}" FontSize="12"/>
                                                <TextBlock Text="{Binding QuantidadeEstoque, StringFormat='Estoque: {0}'}" FontSize="10" Foreground="{DynamicResource AppTextSecondary}"/>
                                                <Button Content="+ Adicionar" 
                                                        Command="{Binding $parent[UserControl].DataContext.AdicionarItemCarrinhoCaixaCommand}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource AppBtnNeutralBg}" Foreground="White" FontSize="10" Margin="0,4,0,0" Padding="0,4"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Coluna Direita: Cupom, Formas de Pagamento e Metáfora da Maquininha POS -->
                <StackPanel Grid.Column="1" Spacing="14" Margin="14,0,0,0">
                    
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            
                            <!-- Totalizador Grande -->
                            <StackPanel Spacing="1">
                                <TextBlock Text="TOTAL DA VENDA" FontSize="10" Foreground="{DynamicResource AppTextMuted}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding TotalVendaCaixa, StringFormat='R$ {0:F2}'}" 
                                           FontSize="28" FontWeight="Black" Foreground="{DynamicResource AppAccent}"/>
                            </StackPanel>

                            <!-- Itens no Cupom -->
                            <Border Background="{DynamicResource AppItemBg}" BorderBrush="{DynamicResource AppCardBorder}" BorderThickness="1" CornerRadius="6" Padding="8">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Itens no Cupom Fiscal:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondary}"/>
                                    <ItemsControl ItemsSource="{Binding CarrinhoCaixa}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:ItemVenda">
                                                <Grid ColumnDefinitions="*, 35, 55">
                                                    <TextBlock Grid.Column="0" Text="{Binding Produto.Nome}" FontSize="10" Foreground="{DynamicResource AppTextPrimary}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Quantidade, StringFormat='x{0}'}" FontSize="10" Foreground="{DynamicResource AppTextSecondary}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Subtotal, StringFormat='R$ {0:F2}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppAccent}" TextAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Seleção e Cadastro de Cliente (RF04 / RF06 / RF07 / RN10 / RN20) -->
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="Cliente Cadastrado [RF06 / RF04]:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="➕ Novo Cliente [RF06]" 
                                            Command="{Binding ToggleFormularioNovoClienteCommand}"
                                            FontSize="9" Padding="6,2" Background="{DynamicResource AppBtnPrimaryBg}" Foreground="White" CornerRadius="4"/>
                                </Grid>

                                <!-- Formulário Expansível de Cadastro de Cliente (RF06) -->
                                <Border Background="{DynamicResource AppItemBg}" BorderBrush="{DynamicResource AppCardBorder}" BorderThickness="1" CornerRadius="6" Padding="8"
                                        IsVisible="{Binding MostrarFormularioNovoCliente}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Cadastro Rápido de Cliente [RF06]" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource AppTextPrimary}"/>
                                        <TextBox Text="{Binding NovoClienteNome}" Watermark="Nome Completo / Razão Social" FontSize="10" Height="26" Padding="4,2"/>
                                        <Grid ColumnDefinitions="*, *">
                                            <TextBox Grid.Column="0" Text="{Binding NovoClienteCpfCnpj}" Watermark="CPF / CNPJ (11 ou 14 dígitos)" Margin="0,0,2,0" FontSize="10" Height="26" Padding="4,2"/>
                                            <TextBox Grid.Column="1" Text="{Binding NovoClienteTelefone}" Watermark="Telefone / Contato" Margin="2,0,0,0" FontSize="10" Height="26" Padding="4,2"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*, *">
                                            <TextBox Grid.Column="0" Text="{Binding NovoClienteEndereco}" Watermark="Endereço" Margin="0,0,2,0" FontSize="10" Height="26" Padding="4,2"/>
                                            <TextBox Grid.Column="1" Text="{Binding NovoClienteEmail}" Watermark="E-mail" Margin="2,0,0,0" FontSize="10" Height="26" Padding="4,2"/>
                                        </Grid>
                                        <Button Content="💾 Salvar Cliente [RF06]" 
                                                Command="{Binding CadastrarClienteCaixaCommand}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource AppBtnSuccessBg}" Foreground="White" FontSize="10" Padding="0,4" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <ComboBox ItemsSource="{Binding ClientesCaixa}" SelectedItem="{Binding ClienteCaixaSelecionado}"
                                          HorizontalAlignment="Stretch" PlaceholderText="Consumidor Final (Sem cadastro)" FontSize="11">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="m:Cliente">
                                            <TextBlock Text="{Binding Nome}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Card de Situação Financeira do Cliente (RF04 / RF06 / RF07 / RN20) -->
                                <Border Background="{DynamicResource AppItemBg}" CornerRadius="6" Padding="6" BorderThickness="1.5"
                                        BorderBrush="{Binding IsClienteInadimplente, Converter={x:Null}}">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding MensagemStatusCliente}" FontSize="9.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{Binding IsClienteInadimplente, Converter={x:Null}}"/>
                                        
                                        <!-- Botão de Quitar Dívida para teste -->
                                        <Button Content="💳 Quitar Dívida do Cliente (Regularizar)" 
                                                Command="{Binding QuitarDividaClienteSelecionadoCommand}"
                                                IsVisible="{Binding IsClienteInadimplente}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource AppBtnSuccessBg}" Foreground="White" FontSize="9" Padding="0,3"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Seleção de Forma de Pagamento com Botões Claros (RF04 / RN01) -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Forma de Pagamento Aceita [RN01]:" FontSize="10" Foreground="{DynamicResource AppTextSecondary}"/>
                                <Grid ColumnDefinitions="*, *, *" RowDefinitions="Auto, Auto">
                                    <Button Grid.Row="0" Grid.Column="0" Content="💵 Dinheiro" Margin="0,0,2,2"
                                            Command="{Binding SelecionarFormaPagamentoCaixaCommand}" CommandParameter="Dinheiro"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource AppBtnNeutralBg}" Foreground="White" FontSize="10" Padding="0,6"/>
                                    <Button Grid.Row="0" Grid.Column="1" Content="💳 Débito" Margin="2,0,2,2"
                                            Command="{Binding SelecionarFormaPagamentoCaixaCommand}" CommandParameter="CartaoDebito"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource AppBtnNeutralBg}" Foreground="White" FontSize="10" Padding="0,6"/>
                                    <Button Grid.Row="0" Grid.Column="2" Content="💳 Crédito" Margin="2,0,0,2"
                                            Command="{Binding SelecionarFormaPagamentoCaixaCommand}" CommandParameter="CartaoCredito"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource AppBtnNeutralBg}" Foreground="White" FontSize="10" Padding="0,6"/>
                                    <Button Grid.Row="1" Grid.Column="0" Content="📝 Cheque" Margin="0,2,2,0"
                                            Command="{Binding SelecionarFormaPagamentoCaixaCommand}" CommandParameter="Cheque"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource AppBtnNeutralBg}" Foreground="White" FontSize="10" Padding="0,6"/>
                                    <Button Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Content="📑 A Prazo (Empresa) [RF04]" Margin="2,2,0,0"
                                            Command="{Binding SelecionarFormaPagamentoCaixaCommand}" CommandParameter="APrazo"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource AppBtnNeutralBg}" Foreground="White" FontSize="10" Padding="0,6"/>
                                </Grid>
                            </StackPanel>

                            <!-- METÁFORA DO MUNDO REAL: MAQUININHA DE CARTÃO (POS) -->
                            <Border Background="{DynamicResource AppItemBg}" BorderBrush="{DynamicResource AppCardBorder}" BorderThickness="1.5" CornerRadius="8" Padding="10"
                                    IsVisible="{Binding IsPagamentoCartao}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="Auto, *">
                                        <TextBlock Grid.Column="0" Text="📟 " FontSize="18"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Terminal TEF / Maquininha de Cartão" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AppTextPrimary}"/>
                                            <TextBlock Text="Metáfora de operação com cartão no mundo real:" FontSize="9" Foreground="{DynamicResource AppTextSecondary}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Visor da Maquininha -->
                                    <Border Background="{DynamicResource AppCardBorder}" CornerRadius="4" Padding="8,6">
                                        <TextBlock Text="{Binding CartaoMensagemStatus}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" TextWrapping="Wrap"/>
                                    </Border>

                                    <!-- Botões de Interação do Cliente/Operador -->
                                    <Grid ColumnDefinitions="*, *">
                                        <Button Grid.Column="0" Content="📲 Aproximar (NFC)" Margin="0,0,3,0"
                                                Command="{Binding SimularAproximacaoCartaoCommand}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource AppBtnPrimaryBg}" Foreground="White" FontSize="10" Padding="0,6"/>
                                        <Button Grid.Column="1" Content="💳 Inserir Chip &amp; Senha" Margin="3,0,0,0"
                                                Command="{Binding InserirChipCartaoCommand}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource AppBtnPrimaryBg}" Foreground="White" FontSize="10" Padding="0,6"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Regra do Vale Lavagem Grátis (RN03) -->
                            <Border Background="{DynamicResource AppItemBg}" BorderBrush="{DynamicResource AppAccent}" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="⭐" FontSize="14"/>
                                    <TextBlock Text="Vendas ≥ R$ 200 ganham 1 Vale-Lavagem válido por 30 dias! [RN03]" 
                                               FontSize="10" Foreground="{DynamicResource AppAccent}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Botões de Finalização -->
                            <Button Content="FINALIZAR VENDA" 
                                    Command="{Binding FinalizarVendaCaixaCommand}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Height="38" FontWeight="Black" FontSize="13" Background="{DynamicResource AppBtnSuccessBg}" Foreground="White" CornerRadius="6"/>

                            <Button Content="Limpar Carrinho" 
                                    Command="{Binding LimparCarrinhoCaixaCommand}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource AppBtnNeutralBg}" Foreground="White" CornerRadius="6" FontSize="11" Padding="0,4"/>

                        </StackPanel>
                    </Border>

                </StackPanel>

            </Grid>

            <!-- Histórico de Vendas com NF-e (RF03) e Cancelamento até 30 Minutos (RN17) -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="Histórico de Vendas Recentes" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AppTextPrimary}"/>
                        <WrapPanel Grid.Column="1">
                            <Border Classes="badge"><TextBlock Text="RF03: Emissão NF-e"/></Border>
                            <Border Classes="badge"><TextBlock Text="RN17: Cancelamento 30 Min"/></Border>
                        </WrapPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding HistoricoVendasCaixa}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:Venda">
                                <Border Background="{DynamicResource AppItemBg}" BorderBrush="{DynamicResource AppCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,3">
                                    <Grid ColumnDefinitions="70, 120, *, 90, Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding IdVenda, StringFormat='Venda #{0}'}" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DataHora, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Foreground="{DynamicResource AppTextSecondary}" FontSize="11"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Cliente.Nome, FallbackValue='Consumidor Avulso'}" Foreground="{DynamicResource AppTextPrimary}" FontSize="11"/>
                                        <TextBlock Grid.Column="3" Text="{Binding ValorTotal, StringFormat='R$ {0:F2}'}" FontWeight="Bold" Foreground="{DynamicResource AppAccent}" FontSize="11"/>
                                        
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
                                            <Button Content="Emitir NF-e [RF03]" 
                                                    Command="{Binding $parent[UserControl].DataContext.EmitirNotaFiscalCaixaCommand}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,3" FontSize="10" Background="{DynamicResource AppBtnPrimaryBg}" Foreground="White"/>
                                            <Button Content="Cancelar [RN17]" 
                                                    Command="{Binding $parent[UserControl].DataContext.CancelarVendaCaixaCommand}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,3" FontSize="10" Background="{DynamicResource AppBtnDangerBg}" Foreground="White"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>